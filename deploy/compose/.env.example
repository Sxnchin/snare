# Copy to .env, or let ./lab.sh up generate it. Never commit .env.
POSTGRES_PASSWORD=change-me
# Path to the pinned ARTEX checkout, relative to this directory.
ARTEX_SRC=../../../ARTEX

# Hosts ARTEX may reach through the egress proxy: host:port, comma-separated.
# Only the one provider in use. lab.sh test-egress checks that others are refused.
LLM_EGRESS_ALLOW=api.deepseek.com:443

# LLM for ARTEX runs: DeepSeek through its OpenAI-compatible API (see
# docs/ASSUMPTIONS.md for why not the Anthropic-format endpoint).
ARTEX_LLM_PROVIDER=openai
ARTEX_LLM_BASE_URL=https://api.deepseek.com
ARTEX_LLM_MODEL=deepseek-flash
# Paste your DeepSeek API key after the = yourself. Snare never sets a key.
OPENAI_API_KEY=

# Lab brakes (defaults in compose.yaml):
# ARTEX_NOISE_PROFILE=quiet
# ARTEX_TASK_BUDGET_TOKENS=2000000
# ARTEX_TASK_BUDGET_TURNS=400
# ARTEX_INTENT_BUDGET_TOKENS=200000
# ARTEX_INTENT_BUDGET_TURNS=40
