# Copy to .env, or let ./lab.sh up generate it. Never commit .env.
POSTGRES_PASSWORD=change-me
# Path to the pinned ARTEX checkout, relative to this directory.
ARTEX_SRC=../../../ARTEX

# Hosts ARTEX may reach through the egress proxy: host[:port], comma-separated.
# Narrow this to the one provider you use.
LLM_EGRESS_ALLOW=api.openai.com,api.anthropic.com

# LLM for ARTEX runs (needed from M2). Snare never sets a key for you. A cheap OpenAI-compatible model works.
# OPENAI_API_KEY=
# ARTEX_LLM_PROVIDER=openai
# ARTEX_LLM_MODEL=
# ARTEX_LLM_BASE_URL=

# Lab brakes (defaults in compose.yaml):
# ARTEX_NOISE_PROFILE=quiet
# ARTEX_TASK_BUDGET_TOKENS=2000000
# ARTEX_TASK_BUDGET_TURNS=400
# ARTEX_INTENT_BUDGET_TOKENS=200000
# ARTEX_INTENT_BUDGET_TURNS=40
