# Snare's default data directory (data/snare.db, data/secret.key,
# data/api.token) is relative to the working directory, so it can appear
# wherever snare or a test is run from, not only at the repository root.
data/
# Secrets by default file name, wherever they end up.
secret.key
api.token
/snare
*.db
*.db-shm
*.db-wal
# Environment files and every variant of them, anywhere: they can hold keys.
# Only the documented example is tracked.
.env
.env.*
*.env
!.env.example
# Editor and tool backups (nano .save, vim .swp/.swo, emacs ~ and #...#,
# .bak, .orig, .tmp copies), which can copy a secret file.
*.save
*.save.[0-9]*
*.swp
*.swo
*.swn
*~
\#*\#
.\#*
*.bak
*.orig
*.rej
*.tmp
deploy/compose/secrets/
deploy/compose/run/
